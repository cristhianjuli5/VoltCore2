<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/banner_width"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/margin_medium"
    app:cardCornerRadius="@dimen/card_corner_radius_medium"
    app:cardBackgroundColor="@color/volt_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/margin_standard">

        <TextView
            android:id="@+id/tvPromoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/promo_title"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_h4"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ivPromo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/promo_desc"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_price"
            app:layout_constraintEnd_toStartOf="@+id/ivPromo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPromoTitle" />

        <ImageView
            android:id="@+id/ivPromo"
            android:layout_width="@dimen/banner_icon_size"
            android:layout_height="@dimen/banner_icon_size"
            android:src="@drawable/ic_voltcore_logo"
            android:contentDescription="@string/promotion_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/black" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
