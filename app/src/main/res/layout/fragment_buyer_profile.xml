<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volt_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin_large"
        android:gravity="center_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/profile_image_size"
            android:layout_height="@dimen/profile_image_size"
            app:cardCornerRadius="@dimen/profile_image_corner"
            app:strokeColor="@color/volt_primary"
            app:strokeWidth="@dimen/stroke_width_medium"
            android:layout_marginBottom="@dimen/margin_standard">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_voltcore_logo"
                android:padding="@dimen/dialog_padding"
                android:scaleType="centerInside"
                android:background="@color/glass_surface"
                android:contentDescription="@string/profile_photo_desc"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_loading"
            android:textColor="@color/volt_text_primary"
            android:textSize="@dimen/text_size_h3"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_tiny"/>

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_email"
            android:textColor="@color/volt_text_secondary"
            android:layout_marginBottom="@dimen/margin_xlarge"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/full_name_label"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="@dimen/margin_standard"
            app:boxStrokeColor="@color/volt_primary"
            app:hintTextColor="@color/volt_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/volt_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shipping_address_label"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="@dimen/margin_standard"
            app:boxStrokeColor="@color/volt_primary"
            app:hintTextColor="@color/volt_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/volt_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_medium"
            android:text="@string/update_profile"
            android:backgroundTint="@color/glass_surface"
            android:textColor="@color/volt_text_primary"
            app:strokeColor="@color/volt_primary"
            app:strokeWidth="@dimen/stroke_width_standard"
            app:cornerRadius="@dimen/card_corner_radius"
            android:layout_marginBottom="@dimen/margin_medium"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_medium"
            android:text="@string/change_password"
            android:backgroundTint="@color/glass_surface"
            android:textColor="@color/volt_text_primary"
            app:strokeColor="@color/volt_primary"
            app:strokeWidth="@dimen/stroke_width_standard"
            app:cornerRadius="@dimen/card_corner_radius"
            android:layout_marginBottom="@dimen/margin_standard"
            app:icon="@android:drawable/ic_lock_idle_lock"
            app:iconTint="@color/volt_primary"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_width_standard"
            android:background="@color/glass_stroke"
            android:layout_marginVertical="@dimen/margin_standard"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyOrders"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_medium"
            android:text="@string/order_history"
            android:backgroundTint="@color/volt_primary"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:cornerRadius="@dimen/card_corner_radius"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconTint="@color/black" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
