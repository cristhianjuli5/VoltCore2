<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para el perfil del comprador.
    Permite visualizar y actualizar la información personal, cambiar la contraseña
    y acceder al historial de pedidos.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/volt_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Foto de Perfil (Simulada con CardView para hacerlo circular) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:strokeColor="@color/volt_primary"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_voltcore_logo"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:background="@color/glass_surface"
                android:contentDescription="@string/profile_photo_desc"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_loading"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_email"
            android:textColor="@color/white_70"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/full_name_label"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/volt_primary"
            app:hintTextColor="@color/volt_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shipping_address_label"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/volt_primary"
            app:hintTextColor="@color/volt_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/update_profile"
            android:backgroundTint="@color/glass_surface"
            android:textColor="@color/white"
            app:strokeColor="@color/volt_primary"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/change_password"
            android:backgroundTint="@color/glass_surface"
            android:textColor="@color/white"
            app:strokeColor="@color/volt_primary"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/ic_lock_idle_lock"
            app:iconTint="@color/volt_primary"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_stroke"
            android:layout_marginVertical="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyOrders"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/order_history"
            android:backgroundTint="@color/volt_primary"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconTint="@color/black" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
