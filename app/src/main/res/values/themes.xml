<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VoltCore" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/volt_primary</item>
        <item name="android:windowBackground">@color/volt_background</item>
        <item name="colorSurface">@color/glass_surface</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="Widget.VoltCore.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner_radius_xlarge</item>
        <item name="cardBackgroundColor">@color/volt_card_background</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/stroke_width_standard</item>
    </style>

    <style name="Widget.VoltCore.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/card_corner_radius</item>
        <item name="backgroundTint">@color/volt_primary</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.VoltCore" parent="Base.Theme.VoltCore" />
</resources>
